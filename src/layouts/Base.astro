---
import '@fontsource/young-serif/latin-400.css';
import '@fontsource/source-sans-3/latin-400.css';
import '@fontsource/source-sans-3/latin-600.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-600.css';
import '@/styles/global.css';
import serif from '@fontsource/young-serif/files/young-serif-latin-400-normal.woff2?url';
import sans from '@fontsource/source-sans-3/files/source-sans-3-latin-400-normal.woff2?url';
import SearchButton from '@/components/SearchButton.astro';
import ThemeToggle from '@/components/ThemeToggle.astro';
import Todo from '@/components/Todo.astro';
import { formatDate, getNav, getSite, isoDate } from '@/lib/content';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}
const site = await getSite();
const { title, description = site.description, type = 'website', noindex = false } = Astro.props;
const pageTitle = title ? `${title} | ${site.name}` : `${site.name} | ${site.role}`;
const path = Astro.url.pathname.replace(/\/$/, '').replace(/\.html$/, '');
const canonical = new URL(path || '/', Astro.site);
const ogImage = new URL(noindex ? '/og/index.png' : `/og${path || '/index'}.png`, Astro.site);
const built = new Date();
const nav = await getNav();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#f7f4f6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1d141d" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name}: blog`} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href={serif} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sans} as="font" type="font/woff2" crossorigin />
    <script is:inline>
      try {
        const saved = localStorage.getItem('theme');
        if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved;
      } catch {
        /* Storage is blocked: follow the system theme. */
      }
    </script>
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="bg-accent text-paper sr-only focus:not-sr-only focus:absolute focus:z-10 focus:p-3"
    >
      Skip to content
    </a>
    <header class="wrap flex flex-wrap items-center gap-x-6 gap-y-1 py-5">
      <a href="/" class="font-display hover:text-accent mr-auto py-1 text-xl">
        {site.name}
      </a>
      <div>
        <SearchButton />
      </div>
      <nav aria-label="Main" class="w-full md:w-auto">
        <ul class="grid grid-cols-3 gap-x-6 sm:flex sm:flex-wrap sm:gap-x-5">
          {nav.map(([text, href]) => {
            const current = path === href || path.startsWith(`${href}/`);
            return (
              <li>
                <a
                  href={href}
                  aria-current={current ? 'page' : undefined}
                  class:list={[
                    'hover:text-accent inline-block py-2 text-[1.0625rem]',
                    current && 'text-accent underline underline-offset-8',
                  ]}
                >
                  {text}
                </a>
              </li>
            );
          })}
        </ul>
      </nav>
    </header>
    <main id="main" class="wrap flex-1 pt-8 pb-20 sm:pt-14">
      <slot />
    </main>
    <footer class="border-rule border-t">
      <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 py-6 text-base">
        <ul class="flex flex-wrap items-center gap-x-5 gap-y-1">
          <li>
            <a class="link inline-block py-2" href={site.github}>
              GitHub
            </a>
          </li>
          <li>
            {site.linkedin ? (
              <a class="link inline-block py-2" href={site.linkedin}>
                LinkedIn
              </a>
            ) : (
              <Todo text="LinkedIn URL" />
            )}
          </li>
          {site.source && (
            <li>
              <a class="link inline-block py-2" href={site.source}>
                Site source
              </a>
            </li>
          )}
          <li>
            <a class="link inline-block py-2" href="/rss.xml">
              RSS
            </a>
          </li>
          <li>
            <ThemeToggle />
          </li>
        </ul>
        <p class="text-soft">
          Last updated <time datetime={isoDate(built)}>{formatDate(built)}</time>
        </p>
      </div>
    </footer>
    <script is:inline define:vars={{ github: site.github, owner: site.name }}>
      console.log(
        `%cHello, fellow engineer.\n%cThis site is static Astro with a little TypeScript. ${owner}'s code is at ${github}`,
        'font: 600 16px Georgia, serif',
        'font: 14px sans-serif',
      );
    </script>
  </body>
</html>
