---
import { formatDate, getNotebooks, getNowEntries, getPosts, isoDate } from '@/lib/content';

/** Built from the dates of published posts, notebooks and Now entries. */
const WEEKS = 26;
const DAY = 86_400_000;
/** A nearly empty grid says the wrong thing, so production waits for this many active days. */
const MIN_ACTIVE_DAYS = 5;

const entries = [
  ...(await getPosts())
    .filter((p) => !p.data.draft)
    .map((p) => ({ date: p.data.date, text: p.data.title, href: `/blog/${p.id}` })),
  ...(await getNotebooks()).map((n) => ({
    date: n.data.date,
    text: n.data.title,
    href: `/notebooks/${n.id}`,
  })),
  ...(await getNowEntries()).map((n, i) => ({
    date: n.data.date,
    text: 'Now entry',
    href: i === 0 ? '/now' : `/now/${n.id}`,
  })),
].sort((a, b) => b.date.getTime() - a.date.getTime());

const today = Date.parse(isoDate(new Date()));
// Weeks start on Monday. The last column is the current week.
const weekday = (new Date(today).getUTCDay() + 6) % 7;
const first = today - (weekday + (WEEKS - 1) * 7) * DAY;
const counts = new Map<number, number>();
for (const entry of entries) {
  const day = Date.parse(isoDate(entry.date));
  if (day >= first && day <= today) counts.set(day, (counts.get(day) ?? 0) + 1);
}
const recent = entries.filter((e) => e.date.getTime() >= first && e.date.getTime() <= today);

const weeks = Array.from({ length: WEEKS }, (_, w) => {
  const days = Array.from({ length: 7 }, (_, d) => first + (w * 7 + d) * DAY).filter(
    (day) => day <= today,
  );
  const monday = new Date(first + w * 7 * DAY);
  const isNewMonth = w === 0 || monday.getUTCDate() <= 7;
  const month = isNewMonth
    ? monday.toLocaleDateString('en-GB', { month: 'short', timeZone: 'UTC' })
    : '';
  return { days, month };
});
// The first label is dropped when the next month starts right after it, so they cannot overlap.
if (weeks.slice(1, 3).some((week) => week.month) && weeks[0]) weeks[0].month = '';

const summary = `${recent.length} ${recent.length === 1 ? 'entry' : 'entries'} on ${counts.size} ${counts.size === 1 ? 'day' : 'days'} in the last ${WEEKS} weeks`;
const show = import.meta.env.DEV || counts.size >= MIN_ACTIVE_DAYS;
---

{show && (
  <section class="mt-16" aria-labelledby="activity">
    <h2 class="text-2xl" id="activity">
      Published activity
    </h2>
    <p class="mt-2">{summary}: posts, notebooks and Now entries.</p>
    <div class="scroll" tabindex="0" role="region" aria-label="Activity by day">
      <div class="grid-map" role="img" aria-label={summary}>
        {weeks.map(({ days, month }) => (
          <div class="week">
            <span class="month">{month}</span>
            {days.map((day) => {
              const n = counts.get(day) ?? 0;
              const label = `${formatDate(new Date(day))}: ${n || 'no'} ${n === 1 ? 'entry' : 'entries'}`;
              return <span class="day" data-level={Math.min(n, 3)} title={label} />;
            })}
          </div>
        ))}
      </div>
    </div>
    <p class="legend meta" aria-hidden="true">
      0
      {[0, 1, 2, 3].map((level) => (
        <span class="day" data-level={level} />
      ))}
      3 or more a day
    </p>
    {recent.length > 0 && (
      <details class="mt-3">
        <summary class="meta cursor-pointer py-1">Show as a list</summary>
        <ul class="mt-2 grid gap-1">
          {recent.map((entry) => (
            <li>
              <span class="meta mr-3">{formatDate(entry.date)}</span>
              <a class="link" href={entry.href}>
                {entry.text}
              </a>
            </li>
          ))}
        </ul>
      </details>
    )}
  </section>
)}

<style>
  /* Right to left, so a narrow screen opens at the latest weeks. */
  .scroll {
    direction: rtl;
    overflow-x: auto;
    margin-top: 1rem;
    padding-bottom: 0.5rem;
  }
  .grid-map {
    direction: ltr;
    margin-right: auto;
    display: flex;
    gap: 3px;
    width: max-content;
  }
  .week {
    display: grid;
    grid-auto-rows: 14px;
    grid-template-rows: 1.4rem;
    gap: 3px;
    width: 14px;
  }
  .month {
    font-size: 0.8125rem;
    line-height: 1.4rem;
    color: var(--soft);
    white-space: nowrap;
  }
  .day {
    display: block;
    width: 14px;
    height: 14px;
    border-radius: 2px;
    background: color-mix(in oklab, var(--rule) 70%, var(--paper));
  }
  .day[data-level='1'] {
    background: color-mix(in oklab, var(--accent) 45%, var(--paper));
  }
  .day[data-level='2'] {
    background: color-mix(in oklab, var(--accent) 70%, var(--paper));
  }
  .day[data-level='3'] {
    background: var(--accent);
  }
  .week .day:hover {
    outline: 2px solid var(--ink);
  }
  .legend {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px;
  }
</style>
