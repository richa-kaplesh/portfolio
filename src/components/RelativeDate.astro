---
import { formatDate, isoDate } from '@/lib/content';

interface Props {
  date: Date;
}
const { date } = Astro.props;
---

{/* The real date ships in the HTML. A script turns it into "N days ago", so it never goes stale. */}
<time datetime={isoDate(date)} data-relative>
  {formatDate(date)}
</time>

<script>
  for (const el of document.querySelectorAll<HTMLTimeElement>('time[data-relative]')) {
    const days = Math.floor((Date.now() - Date.parse(el.dateTime)) / 86_400_000);
    if (days < 0) continue;
    el.title = el.textContent ?? '';
    el.textContent = days === 0 ? 'today' : days === 1 ? 'yesterday' : `${days} days ago`;
  }
</script>
