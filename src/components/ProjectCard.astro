---
import type { CollectionEntry } from 'astro:content';
import { statusLabel } from '@/lib/content';
import ProjectLinks from './ProjectLinks.astro';
import StatusPill from './StatusPill.astro';

interface Props {
  project: CollectionEntry<'projects'>;
}
const { project } = Astro.props;
const { data } = project;
---

<li
  class="border-rule grid gap-3 border-t py-7 sm:grid-cols-[minmax(0,1fr)_13rem] sm:gap-10"
  data-filter={data.tags.join('|')}
>
  <div class="grid content-start gap-2">
    <h2 class="text-2xl">
      <a class="hover:text-accent" href={`/projects/${project.id}`}>
        {data.title}
      </a>
      {data.status === 'in-progress' && (
        <span class="meta border-soft ml-2 rounded-sm border px-1.5 py-0.5 align-middle">
          {statusLabel[data.status]}
        </span>
      )}
    </h2>
    <p class="max-w-2xl leading-snug">{data.tagline}</p>
    {data.healthUrl && (
      <StatusPill id={project.id} project={data.title} url={data.healthUrl} href={data.liveUrl} />
    )}
    <ProjectLinks project={data} />
  </div>
  <p class="meta content-start leading-relaxed">{data.tags.join(', ')}</p>
</li>
