---
import Contact from '@/components/Contact.astro';
import Experience from '@/components/Experience.astro';
import Todo from '@/components/Todo.astro';
import Base from '@/layouts/Base.astro';
import { getSite } from '@/lib/content';

const site = await getSite();
---

<Base title="About" description={`About ${site.name}, ${site.role}.`}>
  <div class="grid max-w-3xl gap-5">
    <h1 class="text-4xl sm:text-5xl">About</h1>
    {site.photo ? (
      <img src={site.photo} alt={site.name} width="160" height="160" class="rounded-[3px]" />
    ) : (
      <Todo text="photo or avatar (optional)" />
    )}
    {site.bio ? (
      <p class="text-xl leading-normal">{site.bio}</p>
    ) : (
      <Todo text="one-paragraph bio" />
    )}
    {site.location ? <p class="meta">{site.location}</p> : <Todo text="location line" />}
    {site.resume && (
      <p>
        <a class="button button-solid" href={site.resume}>
          Download resume (PDF)
        </a>
      </p>
    )}
  </div>

  <section class="mt-16" aria-labelledby="experience">
    <h2 class="text-3xl" id="experience">
      Experience and education
    </h2>
    <div class="mt-6">
      <Experience />
    </div>
  </section>

  {site.skills.length > 0 && (
    <section class="mt-16" aria-labelledby="skills">
      <h2 class="text-3xl" id="skills">
        Skills
      </h2>
      <dl class="mt-6 grid max-w-4xl">
        {site.skills.map(({ group, items }) => (
          <div class="border-rule grid gap-1 border-t py-4 sm:grid-cols-[11rem_minmax(0,1fr)] sm:gap-8">
            <dt class="meta leading-relaxed">{group}</dt>
            <dd class="leading-relaxed">{items.join(', ')}</dd>
          </div>
        ))}
      </dl>
    </section>
  )}

  <section class="mt-16 grid gap-5" aria-labelledby="contact">
    <h2 class="text-3xl" id="contact">
      Contact
    </h2>
    <Contact />
  </section>
</Base>
