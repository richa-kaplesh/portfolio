---
import NowEntry from '@/components/NowEntry.astro';
import Base from '@/layouts/Base.astro';
import { formatDate, getNowEntries } from '@/lib/content';

export async function getStaticPaths() {
  const [, ...older] = await getNowEntries();
  return older.map((entry) => ({ params: { date: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const title = `Then: ${formatDate(entry.data.date)}`;
---

<Base title={title} description="What I was working on and learning at the time.">
  <p class="meta">
    <a class="link" href="/now">
      What I'm doing now
    </a>
  </p>
  <h1 class="mt-4 text-4xl sm:text-5xl">{title}</h1>
  <NowEntry entry={entry} />
</Base>
